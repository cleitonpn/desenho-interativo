rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function dono(uid) { return logado() && request.auth.uid == uid; }
    function ehAdmin() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.admin == true;
    }

    // Dados pessoais do mailing: so a propria pessoa e o Vital enxergam.
    match /usuarios/{uid} {
      allow read: if dono(uid) || ehAdmin();
      allow create: if dono(uid);
      // O proprio usuario nunca pode se promover a admin.
      allow update: if (dono(uid) && !('admin' in request.resource.data.diff(resource.data).affectedKeys()))
                    || ehAdmin();
      allow delete: if ehAdmin();
    }

    // Acessorios que o Vital sobe pelo painel. Todo mundo precisa ler para
    // montar a galinha; so o Vital escreve.
    match /pecas/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Conteudo do estudio: a bio, as fotos e a galeria. Todo mundo le; so o
    // Vital escreve.
    match /conteudo/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }
    match /tattoos/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }
    match /personagens/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }
    match /produtos/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }
    match /fretes/{id} {
      allow read: if true;
      allow write: if ehAdmin();
    }

    // Progresso pessoal: so a propria pessoa mexe no seu.
    match /progresso/{uid} {
      allow read, write: if dono(uid);
    }

    // Telemetria. Qualquer pessoa logada soma nos contadores; so o Vital le.
    // Os documentos nao guardam nada que identifique alguem alem do uid da
    // sessao, e ninguem pode ler o que os outros fizeram.
    match /metricas/{id} {
      allow read: if ehAdmin();
      allow write: if logado();
    }
    match /sessoes/{id} {
      allow read: if ehAdmin();
      allow create, update: if logado();
    }

    // Criacoes publicas alimentam a vitrine da abertura, entao sao legiveis
    // por qualquer um — inclusive por quem ainda nao entrou.
    match /criacoes/{id} {
      allow read: if resource.data.publica == true || dono(resource.data.uid) || ehAdmin();
      allow create: if dono(request.resource.data.uid);
      allow update, delete: if dono(resource.data.uid) || ehAdmin();
    }
  }
}
