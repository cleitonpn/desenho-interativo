rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Imagens enviadas ao Vital pelo WhatsApp: o link precisa abrir para ele,
    // mas so o dono da pasta pode escrever, e so PNG ate 8 MB.
    // Acessorios publicados pelo painel: leitura livre, escrita so do Vital.
    match /pecas/{slot}/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.admin == true
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType == 'image/png';
    }

    // Fotos do estudio e da galeria: leitura livre, escrita so do Vital.
    match /{pasta}/{arquivo} {
      allow read: if pasta in ['sobre', 'tattoos', 'produtos'];
      allow write: if pasta in ['sobre', 'tattoos', 'produtos']
                   && request.auth != null
                   && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.admin == true
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /criacoes/{uid}/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType == 'image/png';
    }
  }
}
