rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Imagens enviadas ao Vital pelo WhatsApp: o link precisa abrir para ele,
    // mas so o dono da pasta pode escrever, e so PNG ate 8 MB.
    match /criacoes/{uid}/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType == 'image/png';
    }
  }
}
